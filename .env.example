# parkrun scraper — Postgres connection (no creds in source code)
# Copy to .env, fill real values, then:  set -a; . ./.env; set +a

# Option A: discrete vars
PG_HOST=<<postgreSQL Server>>
PG_PORT=<<port>>
PG_USER=<<username>>
PG_PASSWORD= <<password>>
PG_DATABASE=<<database name>>

# Option B: single DSN (takes precedence if set)
#PG_DSN=postgresql://<<usernam>>@<<postgreSQL Server>>:<<port>>/<<database>>
